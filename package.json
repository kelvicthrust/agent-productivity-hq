{
  "name": "agent-productivity-hq",
  "version": "1.2.1",
  "private": true,
  "license": "MIT",
  "description": "Agent Productivity HQ joins merged PRs with Codex and Claude Code usage in a local dashboard.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production vite build",
    "pack:cli": "node scripts/pack-cli.ts",
    "pack:paseo": "node scripts/pack-paseo.ts",
    "test:cli-package": "node scripts/test-cli-package.ts",
    "test:paseo-package": "node scripts/test-paseo-package.ts",
    "start": "node src/server/main.ts",
    "preview:seed": "node scripts/preview-seed.ts",
    "seed": "node test/fixtures/seed.ts",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:tokens": "vitest run test/tokens",
    "test:e7": "vitest run test/e7",
    "test:contract": "vitest run test/contract",
    "test:e2e": "playwright test",
    "bench": "vitest run --config vitest.bench.config.ts",
    "bench:browser": "node scripts/measure-browser.ts",
    "experiments:selftest": "vitest run test/experiments",
    "reconcile": "node scripts/reconcile-usage.ts",
    "tokens:generate": "node scripts/generate-tokens.ts",
    "tokens:check": "node scripts/generate-tokens.ts --check",
    "check:pins": "node scripts/check-pins.ts",
    "verify": "pnpm check:pins && pnpm typecheck && pnpm lint && pnpm format:check && pnpm tokens:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.9",
    "@astryxdesign/theme-stone": "0.7.9",
    "@getpaseo/client": "0.15.3",
    "@hono/node-server": "2.1.6",
    "@napi-rs/keyring": "2.1.2",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.107.1",
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
