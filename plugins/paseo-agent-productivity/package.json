  },
  "devDependencies": {
    "@getpaseo/plugin": "0.16.1",
    "@types/node": "26.6.6",
    "@types/react": "19.2.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
