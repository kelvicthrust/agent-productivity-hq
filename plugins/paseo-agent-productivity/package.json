{
  "name": "@kelvicthrust/paseo-agent-productivity-hq",
  "version": "1.1.2",
  "private": true,
  "description": "Open Agent HQ in Paseo to view agent usage and merged GitHub pull requests.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvicthrust/agent-productivity-hq.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
